# Server
NODE_ENV=development
PORT=4000

# Database (PostgreSQL)
DATABASE_URL="postgresql://ksmilk:ksmilk@localhost:5432/ksmilk?schema=public"

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Business defaults (seed values; live values are stored in BusinessSettings table)
BUSINESS_LAT=12.9716
BUSINESS_LNG=77.5946
BUSINESS_TIMEZONE=Asia/Kolkata

# Payment provider (Razorpay-style). Leave blank to use the "dev" no-op adapter.
PAYMENT_PROVIDER=dev
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Notifications
SMS_PROVIDER=dev
EMAIL_PROVIDER=dev
PUSH_PROVIDER=dev

# CORS
CORS_ORIGIN=http://localhost:3000

# Google SSO (customer + admin). Create an OAuth 2.0 Client ID (Web
# application) in Google Cloud Console; leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
